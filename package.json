{
  "name": "downloader-monorepo",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=downlink-backend",
    "build:all": "npx turbo build",
    "dev": "npx turbo dev",
    "lint": "npx turbo lint",
    "test": "npx turbo test",
    "clean": "npx turbo clean",
    "start": "node server.js",
    "build:frontend": "npm run build --workspace=downlink-frontend",
    "start:frontend": "npm run start --workspace=downlink-frontend",
    "build:backend": "npm run build --workspace=downlink-backend",
    "start:backend": "node server.js",
    "package:hostinger": "node scripts/package-hostinger-frontend.js",
    "package:backend": "node scripts/package-hostinger-backend.js"
  },
  "dependencies": {
    "turbo": "^2.4.4"
  },
  "packageManager": "npm@11.19.0"
}

