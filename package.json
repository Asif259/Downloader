{
  "name": "downloader-monorepo",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build --filter=downlink-backend",
    "build:all": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "clean": "turbo clean",
    "start": "node server.js",
    "build:frontend": "turbo run build --filter=downlink-frontend",
    "start:frontend": "npm run start --workspace=downlink-frontend",
    "build:backend": "turbo run build --filter=downlink-backend",
    "start:backend": "node server.js",
    "package:hostinger": "node scripts/package-hostinger-frontend.js",
    "package:backend": "node scripts/package-hostinger-backend.js"
  },
  "devDependencies": {
    "turbo": "^2.4.4"
  },
  "packageManager": "npm@11.19.0"
}

